# Shuffle environment -- copy to shuffle/.env and replace every CHANGE_ME.
# shuffle/.env is gitignored.

# First-run admin account (username/password min length 3)
SHUFFLE_DEFAULT_USERNAME=admin
SHUFFLE_DEFAULT_PASSWORD=CHANGE_ME_shuffle_admin
# Pre-seeded admin API key (used by scripts/automation). Make it long/random:
SHUFFLE_DEFAULT_APIKEY=CHANGE_ME_shuffle_apikey

# REQUIRED: encryption modifier for stored app auth. Do not change after first run.
SHUFFLE_ENCRYPTION_MODIFIER=CHANGE_ME_shuffle_enc_modifier

# Core hostnames/ports
BASE_URL=http://shuffle-backend:5001
BACKEND_HOSTNAME=shuffle-backend
OUTER_HOSTNAME=shuffle-backend
SSO_REDIRECT_URL=http://localhost:3001
FRONTEND_PORT=3001
FRONTEND_PORT_HTTPS=3443
BACKEND_PORT=5001
DOCKER_API_VERSION=1.44

# App hot-load / file storage (relative to shuffle/)
SHUFFLE_APP_HOTLOAD_FOLDER=./shuffle-apps
SHUFFLE_APP_HOTLOAD_LOCATION=./shuffle-apps
SHUFFLE_FILE_LOCATION=./shuffle-files
SHUFFLE_APP_DOWNLOAD_LOCATION=https://github.com/shuffle/python-apps
SHUFFLE_APP_FORCE_UPDATE=false

# Orborus / worker
ENVIRONMENT_NAME=Shuffle
SHUFFLE_SWARM_CONFIG=run
SHUFFLE_WORKER_IMAGE=ghcr.io/shuffle/shuffle-worker:latest
SHUFFLE_ORBORUS_EXECUTION_CONCURRENCY=5
SHUFFLE_CONTAINER_AUTO_CLEANUP=true
SHUFFLE_PASS_WORKER_PROXY=TRUE
SHUFFLE_PASS_APP_PROXY=TRUE
SHUFFLE_SKIPSSL_VERIFY=true
IS_KUBERNETES=false
TZ=UTC

# Datastore (OpenSearch)
SHUFFLE_ELASTIC=true
SHUFFLE_OPENSEARCH_URL=https://shuffle-opensearch:9200
SHUFFLE_OPENSEARCH_USERNAME=admin
SHUFFLE_OPENSEARCH_PASSWORD=CHANGE_ME_opensearch
OPENSEARCH_INITIAL_ADMIN_PASSWORD=CHANGE_ME_opensearch
SHUFFLE_OPENSEARCH_SKIPSSL_VERIFY=true