# ===== SOC Automation Lab v2 -- secrets template =====
# Copy to .env and replace every CHANGE_ME. .env is gitignored.
# Generate strong values, e.g.:  openssl rand -base64 24

# --- Wazuh ---
INDEXER_USERNAME=admin
INDEXER_PASSWORD=CHANGE_ME_indexer
WAZUH_API_USERNAME=wazuh-wui
WAZUH_API_PASSWORD=CHANGE_ME_api
DASHBOARD_USERNAME=kibanaserver
DASHBOARD_PASSWORD=CHANGE_ME_dashboard

# --- TheHive ---
THEHIVE_SECRET=CHANGE_ME_thehive_secret_min32chars_long
THEHIVE_ADMIN_PASSWORD=CHANGE_ME_thehive_admin

# --- Cortex ---
CORTEX_SECRET=CHANGE_ME_cortex_secret_min32chars_long
# Integration API key created in Cortex UI after first boot:
CORTEX_API_KEY=CHANGE_ME_cortex_apikey

# --- Cortex analyzer API keys (free tier) ---
VIRUSTOTAL_API_KEY=CHANGE_ME_vt
ABUSEIPDB_API_KEY=CHANGE_ME_abuseipdb

# --- Shuffle ---
SHUFFLE_DEFAULT_USERNAME=admin
SHUFFLE_DEFAULT_PASSWORD=CHANGE_ME_shuffle
SHUFFLE_ENCRYPTION_KEY=CHANGE_ME_shuffle_enc_key_32bytes
# Webhook URL printed by Shuffle after creating the trigger (Task 9):
SHUFFLE_WEBHOOK_URL=http://shuffle-backend:5001/api/v1/hooks/webhook_CHANGE_ME

# --- TheHive API token for Shuffle (created in TheHive UI, Task 10) ---
THEHIVE_API_KEY=CHANGE_ME_thehive_apikey

# --- Analyst notification (Task 11) ---
ANALYST_EMAIL=analyst@example.local

# --- Critical-IP allowlist: never auto-block these (comma-separated) ---
RESPONSE_ALLOWLIST=127.0.0.1,172.20.0.0/16,10.0.0.0/8